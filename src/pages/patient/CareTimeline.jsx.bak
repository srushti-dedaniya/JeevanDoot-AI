import { useEffect, useMemo, useState } from 'react';
import { useTranslation } from 'react-i18next';
import DashboardLayout from '../../components/layout/DashboardLayout';
import PatientSidebar from '../../components/layout/PatientSidebar';
import Card from '../../components/common/Card';
import Badge from '../../components/common/Badge';
import Button from '../../components/common/Button';
import EmptyState from '../../components/common/EmptyState';
import { useAuth } from '../../hooks/useAuth';
import { api } from '../../services/api';
import { cx } from '../../utils/helpers';

const TYPE_ICONS = {
  appointment: 'event',
  referral: 'share',
  prescription: 'medication',
  consultation: 'medical_services',
  medical_report: 'description',
};

const TYPE_LABELS = {
  appointment: 'patient.timeline.appointment',
  referral: 'patient.timeline.referral',
  prescription: 'patient.timeline.prescription',
  consultation: 'patient.timeline.consultation',
  medical_report: 'patient.timeline.medicalReport',
};

const TYPE_COLORS = {
  appointment: 'primary',
  referral: 'secondary',
  prescription: 'tertiary',
  consultation: 'info',
  medical_report: 'success',
};

export default function CareTimeline() {
  const { t } = useTranslation();
  const { user } = useAuth();
  const role = user?.role || 'patient';

  const [timeline, setTimeline] = useState({ events: [], meta: { page: 1, limit: 20, total: 0, totalPages: 0 } });
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [filters, setFilters] = useState({ from: '', to: '' });
  const [page, setPage] = useState(1);
  const [patientId, setPatientId] = useState(null);
  const [isDoctorView, setIsDoctorView] = useState(false);

  const { patient } = usePatient();

  useEffect(() => {
    if (role === 'patient') {
      setPatientId(patient?._id);
      setIsDoctorView(false);
    }
  }, [role, patient]);

  const fetchTimeline = async (pageNum = 1) => {
    if (!patientId) return;

    setLoading(true);
    setError(null);

    try {
      const params = {
        page: pageNum,
        limit: 20,
        ...(filters.from && { from: filters.from }),
        ...(filters.to && { to: filters.to }),
      };

      const { data, meta } = await api.get(`/patients/${patientId}/timeline`, params);
      setTimeline({ events: data || [], meta });
      setPage(pageNum);
    } catch (err) {
      setError(err.message || 'Failed to load timeline');
      setTimeline({ events: [], meta: { page: 1, limit: 20, total: 0, totalPages: 0 } });
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchTimeline(1);
  }, [patientId, filters.from, filters.to]);

  const handleFilterChange = (key, value) => {
    setFilters(prev => ({ ...prev, [key]: value }));
    setPage(1);
  };

  const handleFilterSubmit = (e) => {
    e.preventDefault();
    fetchTimeline(1);
  };

  const handlePageChange = (newPage) => {
    if (newPage >= 1 && newPage <= timeline.meta.totalPages) {
      fetchTimeline(newPage);
    }
  };

  const handlePatientSelect = (selectedPatientId) => {
    setPatientId(selectedPatientId);
    setPage(1);
  };

  const formatDate = (isoString) => {
    if (!isoString) return '-';
    const date = new Date(isoString);
    return date.toLocaleDateString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  };

  const formatTime = (isoString) => {
    if (!isoString) return '';
    const date = new Date(isoString);
    return date.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
  };

  const getTypeIcon = (type) => TYPE_ICONS[type] || 'circle';
  const getTypeLabel = (type) => t(TYPE_LABELS[type] || type);
  const getTypeColor = (type) => TYPE_COLORS[type] || 'neutral';

  const renderEvent = (event) => {
    const icon = getTypeIcon(event.type);
    const label = getTypeLabel(event.type);
    const color = getTypeColor(event.type);
    const date = formatDate(event.occurredAt);
    const time = formatTime(event.occurredAt);

    return (
      <div key={event.id} className="relative pl-10 pb-6 border-l border-outline-variant/30 last:border-0 last:pb-0">
        <div className="absolute left-0 top-1 w-6 h-6 rounded-full flex items-center justify-center bg-{color}-container text-on-{color}-container text-body-sm shrink-0">
          <span className="material-symbols-outlined">{icon}</span>
        </div>
        <div className="bg-surface-container-low rounded-xl p-4 hover:bg-surface-container transition-colors">
          <div className="flex items-start justify-between gap-3">
            <div className="flex-1 min-w-0">
              <div className="flex items-center gap-2 flex-wrap mb-1">
                <Badge variant={color} icon={icon} size="sm">
                  {getTypeLabel(event.type)}
                </Badge>
                {event.status && (
                  <Badge variant="neutral" size="xs">
                    {event.status}
                  </Badge>
                )}
                {event.metadata?.doctor && (
                  <span className="text-label-sm text-on-surface-variant flex items-center gap-1">
                    <span className="material-symbols-outlined text-[14px]">person</span>
                    {event.metadata.doctor.name}
                    {event.metadata.doctor.specialization && ` · ${event.metadata.doctor.specialization}`}
                  </span>
                )}
              </div>
              <p className="font-semibold text-on-surface text-body-md truncate">{event.title}</p>
              {event.description && (
                <p className="text-body-sm text-on-surface-variant mt-1 line-clamp-2">{event.description}</p>
              )}
              <div className="flex items-center gap-3 mt-2 text-label-sm text-on-surface-variant">
                <span className="flex items-center gap-1">
                  <span className="material-symbols-outlined text-[14px]">calendar_today</span>
                  {date}
                </span>
                {time && (
                  <span className="flex items-center gap-1">
                    <span className="material-symbols-outlined text-[14px]">schedule</span>
                    {time}
                  </span>
                )}
              </div>
            </div>
            {event.metadata?.doctor && (
              <div className="flex items-center gap-2">
                <Badge variant="outline" size="xs" icon="person">
                  {t('patient.timeline.viewDoctor')}
                </Badge>
              </div>
            )}
          </div>
        </div>
      </div>
    );
  };

  if (!patientId && role === 'patient') {
    return (
      <DashboardLayout
        sidebar={<PatientSidebar />}
        headerProps={{ title: t('patient.timeline.title'), subtitle: t('patient.timeline.subtitle') }}
      >
        <Card>
          <div className="text-center py-12">
            <span className="material-symbols-outlined text-6xl text-on-surface-variant/50">timeline</span>
            <p className="mt-4 text-body-lg text-on-surface-variant">{t('patient.timeline.selectPatient')}</p>
          </div>
        </Card>
      </DashboardLayout>
    );
  }

  const canLoadMore = timeline.meta.page < timeline.meta.totalPages;
  const isLastPage = timeline.meta.page >= timeline.meta.totalPages;

  return (
    <DashboardLayout
      sidebar={role === 'patient' ? <PatientSidebar /> : null}
      headerProps={{
        title: t('patient.timeline.title'),
        subtitle: t('patient.timeline.subtitle'),
        right: role === 'doctor' && (
          <select
            value={patientId || ''}
            onChange={(e) => handlePatientSelect(e.target.value)}
            className="bg-surface-container-low border border-outline-variant rounded-lg px-3 py-1.5 text-label-md focus:outline-none"
            aria-label={t('patient.timeline.selectPatient')}
          >
            <option value="">{t('patient.timeline.selectPatient')}</option>
          </select>
)}
        >
      <div className="space-y-6">
        {/* Filters */}
        <Card>
          <form onSubmit={handleFilterSubmit} className="flex flex-col sm:flex-row gap-4 items-start sm:items-end">
            <div className="flex-1 min-w-[200px]">
              <label htmlFor="from" className="block text-label-md font-medium text-on-surface-variant mb-1">
                {t('patient.timeline.from')}
              </label>
              <input
                id="from"
                type="date"
                value={filters.from}
                onChange={(e) => handleFilterChange('from', e.target.value)}
                className="w-full bg-surface-container-low border border-outline-variant rounded-lg custom-input text-body-md px-4 focus:outline-none"
              />
            </div>
            <div className="flex-1 min-w-[200px]">
              <label htmlFor="to" className="block text-label-md font-medium text-on-surface-variant mb-1">
                {t('patient.timeline.to')}
              </label>
              <input
                id="to"
                type="date"
                value={filters.to}
                onChange={(e) => handleFilterChange('to', e.target.value)}
                className="w-full bg-surface-container-low border border-outline-variant rounded-lg custom-input text-body-md px-4 focus:outline-none"
              />
            </div>
            <div className="flex gap-2">
              <Button type="submit" icon="filter_alt">{t('common.filter')}</Button>
              <Button type="button" variant="outline" onClick={() => setFilters({ from: '', to: '' })}>
                {t('common.clear')}
              </Button>
            </div>
          </form>
        </Card>

        {/* Timeline */}
        {error ? (
          <Card className="bg-error-container text-on-error-container">
            <div className="flex items-center gap-3 p-4">
              <span className="material-symbols-outlined text-xl">error</span>
              <div>
                <p className="font-bold">{t('common.error')}</p>
                <p className="text-body-sm">{error}</p>
              </div>
              <Button variant="outline" size="sm" icon="refresh" onClick={() => fetchTimeline(page)}>
                {t('common.retry')}
              </Button>
            </div>
          </Card>
        ) : timeline.events.length === 0 ? (
          <Card>
            <EmptyState
              icon="timeline"
              title={t('patient.timeline.emptyTitle')}
              description={t('patient.timeline.emptyDescription')}
            />
          </Card>
        ) : (
          <>
            <div className="relative pl-4 border-l border-outline-variant/30">
              {timeline.events.map(renderEvent)}
            </div>

            {/* Pagination */}
            {timeline.meta.totalPages > 1 && (
              <div className="flex items-center justify-center gap-2 mt-6">
                <Button
                  variant="outline"
                  size="sm"
                  icon="chevron_left"
                  onClick={() => handlePageChange(page - 1)}
                  disabled={page <= 1}
                >
                  {t('common.previous')}
                </Button>
                <span className="text-body-md text-on-surface-variant min-w-[80px] text-center">
                  {t('common.page', { current: page, total: timeline.meta.totalPages })}
                </span>
                <Button
                  variant="outline"
                  size="sm"
                  icon="chevron_right"
                  onClick={() => handlePageChange(page + 1)}
                  disabled={isLastPage}
                >
                  {t('common.next')}
                </Button>
              </div>
            )}
          </>
        )}
      </div>
    </DashboardLayout>
  );
}

function usePatient() {
  const ctx = useContext(require('../context/PatientContext').default);
  if (!ctx) throw new Error('usePatient must be used within a PatientProvider');
  return ctx;
}

export default CareTimeline;