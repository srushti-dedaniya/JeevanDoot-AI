# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local by default)
MONGODB_URI=mongodb://127.0.0.1:27017/jeevandoot

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS origins (comma separated)
CORS_ORIGIN=http://localhost:5173

# Uploads
MAX_UPLOAD_SIZE_MB=5

# Frontend base URL (not used yet; reserved for future wiring)
FRONTEND_URL=http://localhost:5173

# AI Task Agent provider: "local" (deterministic, default), "openai", "anthropic",
# "openai-compatible" (generic OpenAI-compatible endpoint), or "http" (legacy alias for openai-compatible).
# Secrets stay server-side; never expose these to the frontend.
AI_PROVIDER=local
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_PROVIDER_TIMEOUT_MS=8000
# Provider type for http mode: "openai", "anthropic", "openai-compatible" (default for "http")
AI_PROVIDER_TYPE=openai-compatible
