{
  "name": "jeevandoot-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JeevanDoot / SwasthyaLink REST API (Express + MongoDB)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "seed:reset": "node seed/seed.js --reset",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "eval:local": "node --test tests/ai-eval.test.js",
    "eval:remote": "AI_PROVIDER=http node --test tests/ai-eval.test.js",
    "eval:compare": "node scripts/eval-compare.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
